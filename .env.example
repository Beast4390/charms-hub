# ============================================================
# Charms Hub AI — Frontend Environment Variables
# Copy to .env.local (gitignored) and fill in real values.
# ============================================================

# Supabase (REQUIRED for cloud auth/data). Find both values in
# Supabase Dashboard → Project Settings → API, or run:
#   npx supabase projects api-keys --project-ref <your-project-ref>
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-public-key>"

# SECURITY: Never place GEMINI_API_KEY or any other secret here.
# The React client only ever uses the public anon key above.
# Server-side AI secrets belong exclusively in Supabase Edge Function secrets:
#   npx supabase secrets set GEMINI_API_KEY=<key>
